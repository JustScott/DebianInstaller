declare -r ADMIN_USERNAME='administrator'
declare -r ADMIN_PASSWORD='test' # Cannot be left empty

declare -r USER_USERNAME='test'
declare -r USER_PASSWORD='' # Can be left empty

declare -r TIMEZONE='America/Chicago'

declare -r ENABLE_WIFI='y' # set to 'n' for systems using only ethernet

# Manually partition with cfdisk, then update partition names here
declare -r EFI_PARTITION="/dev/vda1"   # 1GB (EFI system)
declare -r BOOT_PARTITION="/dev/vda2"  # 1GB (Linux filesystem)
declare -r ROOT_PARTITION="/dev/vda3"  # Atleast 10GB for installing system packages (Linux filesystem)
declare -r HOME_PARTITION="/dev/vda4"  # Remaining space for user packages (Linux filesystem)
declare -r OVERWRITE_HOME_PARTITION='n' # 'y' overwrites, 'n' uses existing

# Choose only one method, leave both empty for no encryption
declare -r LUKS_KEYFILE_PARTITION=""
declare -r LUKS_PASSWORD=""

# Leave empty for no swap. Uses root partition space, so be mindful of size
declare -r SWAP_SIZE_IN_GB='4'

# Useful in large deployments, change value accordingly
#declare -r APT_CACHE_SERVER="http://192.168.8.190:3142/"
#declare -r APT_CACHE_FILE="/etc/apt/apt.conf.d/10proxy"

# Leave empty or comment out for a headless install
#  - Supported values: 'gnome'
declare -r DESKTOP_ENVIRONMENT='gnome'
