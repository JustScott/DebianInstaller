HOSTNAME='debian' # Cannot be left empty

ADMIN_USERNAME='administrator'
ADMIN_PASSWORD='test' # Cannot be left empty

USER_USERNAME='test'
USER_PASSWORD='' # Can be left empty

TIMEZONE='America/Chicago'

ENABLE_WIFI='y' # set to 'n' for systems using only ethernet

# Manually partition with cfdisk, then update partition names here
DISK="/dev/vda"
EFI_PARTITION="/dev/vda1"   # 1GB (EFI system)
BOOT_PARTITION="/dev/vda2"  # 1GB (Linux filesystem)
ROOT_PARTITION="/dev/vda3"  # Atleast 10GB for installing system packages (Linux filesystem)
HOME_PARTITION="/dev/vda4"  # Remaining space for user packages (Linux filesystem)
OVERWRITE_HOME_PARTITION='n' # 'y' overwrites, 'n' uses existing

# SKIP_INSTALLING_PACKAGES='y' is what OVERWRITE_ROOT_PARTITION='n' would've
# been. While the root partition is largely overwritten, it's just not formatted
# causing total deletion of all data, like packages.
#
# 'y' means no packages are installed (other than arch-install-scripts). 
# Useful when you want to use the installer to change your password, hostname,
# etc, or you want to add a new luks encryption method. Saves time not 
# reinstalling gnome and all the other large packages.
SKIP_INSTALLING_PACKAGES='n' # cannot be left empty

# Leave both empty for no encryption, set one for a single method of encryption,
# or set both to use the keyfile as a primary method of encryption, and the password
# as a secondary emergency backup method (from a live environment, no prompt on boot)
#
# If reinstalling with OVERWRITE_HOME_PARTITION='n' and you only have home currently
# encrypted with a luks keyfile partition, you can populate the LUKS_PASSWORD field
# and that passphrase will be added to both the home and root luks partitions. Vice
# versa if you have an existing luks password set, you can add a new LUKS_KEYFILE_PARTITION.
LUKS_KEYFILE_PARTITION=""
LUKS_PASSWORD=""

# If using both decryption methods, use the keyfile at boot, and the password
# as an emergency backup method (from a live environment, no prompt on boot).
#   * Or set USE_KEYFILE_AT_BOOT='n' to do the oppposite
USE_KEYFILE_AT_BOOT='y'

# Leave empty for no swap. Uses root partition space, so be mindful of size
SWAP_SIZE_IN_GB='4'

# Useful in large deployments, change value accordingly
#APT_CACHE_SERVER="http://192.168.8.190:3142/"
#APT_CACHE_FILE="/etc/apt/apt.conf.d/10proxy"

# Leave empty or comment out for a headless install
#  - Supported values: 'gnome'
DESKTOP_ENVIRONMENT='gnome'
